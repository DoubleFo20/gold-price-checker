# =======================
#  Gold Trading API - Environment Template
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit ไฟล์ .env)
# =======================

# ---------- DATABASE CONFIG ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goldapidb
DB_USER=root
DB_PASSWORD=your_db_password_here

# ---------- JOB TOKEN ----------
JOB_TOKEN=change_this_to_a_random_secret_token

# ---------- API KEYS ----------
NEWSAPI_KEY=your_newsapi_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ---------- EMAIL SMTP CONFIG ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Gold Trading API"
ENABLE_BACKGROUND_CHECKER=true

# ---------- APPLICATION SETTINGS ----------
APP_ENV=development
FLASK_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/gold-price-checker
SESSION_LIFETIME=604800
RATE_LIMIT_ENABLED=true
SECRET_KEY=change_this_to_a_long_random_string_in_production

# ---------- COOKIE & SECURITY ----------
COOKIE_DOMAIN=
COOKIE_SECURE=false
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ---------- LINE MESSAGING API ----------
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_BOT_ID=@your_line_id
LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@your_line_id

# ---------- WEB PUSH NOTIFICATION (VAPID) ----------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@gmail.com

# ---------- FRONTEND ORIGINS (CORS whitelist) ----------
# ใส่โดเมนของคุณ คั่นด้วย comma เช่น: https://yourapp.com,https://www.yourapp.com
FRONTEND_ORIGINS=

# ---------- PRODUCTION NOTES ----------
# สำหรับ production ให้เปลี่ยน:
#   APP_ENV=production
#   APP_DEBUG=false
#   COOKIE_SECURE=true
#   FRONTEND_ORIGINS=https://your-production-domain.com
